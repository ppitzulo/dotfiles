#!/bin/bash

# Check for correct usage
if [ "$#" -ne 2 ]; then
    echo "Usage: $0 <string_to_find> <string_to_replace>"
    exit 1
fi

# Assign arguments to variables
STRING_TO_FIND=$1
STRING_TO_REPLACE=$2

# Find files containing the string and replace it
rg --files-with-matches "$STRING_TO_FIND" -0 | xargs -0 sed -i "s/$STRING_TO_FIND/$STRING_TO_REPLACE/g"

echo "Replaced all occurrences of '$STRING_TO_FIND' with '$STRING_TO_REPLACE'."

